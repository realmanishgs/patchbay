{
  "$schema": "../schema/plugin.schema.json",
  "id": "sfizz",
  "name": "sfizz",
  "vendor": "sfztools",
  "category": "sampler",
  "license": "BSD-2-Clause",
  "open_source": true,
  "homepage": "https://github.com/sfztools/sfizz",
  "description": "Open-source SFZ sampler engine with VST3, CLAP and AU plugin builds.",
  "notes": null,
  "enabled": true,
  "source": {
    "github": "sfztools/sfizz",
    "asset_patterns": {
      "win_x64": "sfizz-[0-9.]+-win64\\.zip",
      "mac_universal": "sfizz-[0-9.]+-macos\\.tar\\.gz"
    }
  },
  "install_strategy": "bundle_extract",
  "silent_flags": null,
  "auth_type": "none",
  "auth": null,
  "formats": ["vst3", "clap", "au"],
  "federated_feed_url": null,
  "vendor_manifest_url": null
}
