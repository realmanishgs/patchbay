{
  "$schema": "../schema/plugin.schema.json",
  "id": "byod",
  "name": "BYOD",
  "vendor": "ChowDSP",
  "category": "effect",
  "license": "GPL-3.0",
  "open_source": true,
  "homepage": "https://github.com/Chowdhury-DSP/BYOD",
  "description": "Build Your Own Distortion: circuit-modelled guitar and effects processor.",
  "notes": "Windows installer is Inno Setup (verified by signature). The macOS DMG is handled by mounting it and copying any bundles, or running a .pkg if one is present.",
  "enabled": true,
  "source": {
    "github": "Chowdhury-DSP/BYOD",
    "asset_patterns": {
      "win_x64": "BYOD-Win-64bit-[0-9.]+\\.exe",
      "mac_universal": "BYOD-Mac-[0-9.]+\\.dmg"
    }
  },
  "install_strategy": "silent_installer",
  "silent_flags": "/VERYSILENT /NORESTART /SUPPRESSMSGBOXES",
  "auth_type": "none",
  "auth": null,
  "formats": ["vst3", "clap", "au"],
  "federated_feed_url": null,
  "vendor_manifest_url": null
}
