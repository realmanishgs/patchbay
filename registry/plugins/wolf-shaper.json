{
  "$schema": "../schema/plugin.schema.json",
  "id": "wolf-shaper",
  "name": "Wolf Shaper",
  "vendor": "Wolf Plugins",
  "category": "effect",
  "license": "GPL-3.0",
  "open_source": true,
  "homepage": "https://github.com/wolf-plugins/wolf-shaper",
  "description": "Waveshaper with a spline-based graph editor.",
  "about": "Draw a transfer curve with splines and apply it to the signal for distortion, saturation and wavefolding. Its graph editor supports smooth and sharp segments, and the plugin includes oversampling and a post-filter.",
  "tags": ["distortion", "waveshaper", "creative"],
  "enabled": true,
  "source": {
    "github": "wolf-plugins/wolf-shaper",
    "asset_patterns": {
      "win_x64": "wolf-shaper-v[0-9.]+\\+[0-9]+-windows-x64\\.zip",
      "mac_universal": "wolf-shaper-v[0-9.]+-macos-universal\\.zip",
      "linux_x64": "wolf-shaper-v[0-9.]+-linux-x64\\.zip"
    }
  },
  "install_strategy": "bundle_extract",
  "silent_flags": null,
  "auth_type": "none",
  "auth": null,
  "formats": ["vst3", "clap"],
  "federated_feed_url": null,
  "vendor_manifest_url": null
}
