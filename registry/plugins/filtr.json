{
  "$schema": "../schema/plugin.schema.json",
  "id": "filtr",
  "name": "Filtr",
  "vendor": "tiagolr",
  "category": "effect",
  "license": "AGPL-3.0",
  "open_source": true,
  "homepage": "https://github.com/tiagolr/filtr",
  "description": "Envelope-based filter modulator.",
  "about": "Draw a filter envelope and trigger it from MIDI, audio or the host's tempo. Filtr is a quick way to build rhythmic filter movement, similar to the filter section of a groovebox.",
  "tags": ["filter", "modulation", "rhythmic"],
  "enabled": true,
  "source": {
    "github": "tiagolr/filtr",
    "asset_patterns": {
      "win_x64": "filtr-win-v[0-9.]+\\.zip",
      "mac_universal": "filtr-macos-v[0-9.]+\\.zip",
      "linux_x64": "filtr-linux-v[0-9.]+\\.zip"
    }
  },
  "install_strategy": "bundle_extract",
  "silent_flags": null,
  "auth_type": "none",
  "auth": null,
  "formats": ["vst3", "clap"],
  "federated_feed_url": null,
  "vendor_manifest_url": null
}
