{
  "$schema": "../schema/plugin.schema.json",
  "id": "ildaeil",
  "name": "Ildaeil",
  "vendor": "DISTRHO",
  "category": "daw",
  "license": "GPL-2.0-or-later",
  "open_source": true,
  "homepage": "https://github.com/DISTRHO/Ildaeil",
  "description": "Mini plugin host that runs as a plugin inside your DAW.",
  "about": "Ildaeil hosts other plugins inside a single plugin slot. It can load VST2, VST3, CLAP and LV2 plugins, which helps when a DAW cannot load a format directly.\n\nIt is built with the DPF framework and stays light on resources.",
  "tags": ["host", "wrapper", "utility"],
  "enabled": true,
  "source": {
    "github": "DISTRHO/Ildaeil",
    "asset_patterns": {
      "win_x64": "Ildaeil-win64-v[0-9.]+\\.zip",
      "mac_universal": "Ildaeil-macOS-universal-v[0-9.]+\\.zip",
      "linux_x64": "Ildaeil-linux-x86_64-v[0-9.]+\\.zip"
    }
  },
  "install_strategy": "bundle_extract",
  "silent_flags": null,
  "auth_type": "none",
  "auth": null,
  "formats": ["vst3", "clap"],
  "federated_feed_url": null,
  "vendor_manifest_url": null
}
