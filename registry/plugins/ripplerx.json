{
  "$schema": "../schema/plugin.schema.json",
  "id": "ripplerx",
  "name": "RipplerX",
  "vendor": "tiagolr",
  "category": "synth",
  "license": "GPL-3.0",
  "open_source": true,
  "homepage": "https://github.com/tiagolr/ripplerx",
  "description": "Physically modelled synthesizer.",
  "about": "A physical-modelling synth with two resonators that models strings, membranes and tubes. It excites them with noise or a short sample, which makes it good for mallets, plucks, bells and drums.",
  "tags": ["physical-modelling", "synth", "percussion"],
  "enabled": true,
  "source": {
    "github": "tiagolr/ripplerx",
    "asset_patterns": {
      "win_x64": "ripplerx-win-v[0-9.]+\\.zip",
      "mac_universal": "ripplerx-macos-v[0-9.]+\\.zip",
      "linux_x64": "ripplerx-linux-v[0-9.]+\\.zip"
    }
  },
  "install_strategy": "bundle_extract",
  "silent_flags": null,
  "auth_type": "none",
  "auth": null,
  "formats": ["vst3", "clap"],
  "federated_feed_url": null,
  "vendor_manifest_url": null
}
