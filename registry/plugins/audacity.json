{
  "$schema": "../schema/plugin.schema.json",
  "id": "audacity",
  "name": "Audacity",
  "vendor": "Audacity team",
  "category": "daw",
  "license": "GPL-3.0",
  "open_source": true,
  "homepage": "https://github.com/audacity/audacity",
  "description": "Free multi-track audio editor and recorder.",
  "about": "A long-standing audio editor for recording, trimming, cleaning up and exporting sound. It handles multi-track editing, noise reduction and common effects, and hosts plugins.",
  "tags": ["editor", "recording", "restoration"],
  "enabled": true,
  "version_regex": "win-(?P<version>[0-9.]+)-x86_64",
  "source": {
    "github": "audacity/audacity",
    "asset_patterns": {
      "win_x64": "audacity-win-[0-9.]+-x86_64\\.msi"
    }
  },
  "install_strategy": "silent_installer",
  "silent_flags": "/qn /norestart",
  "auth_type": "none",
  "auth": null,
  "formats": [],
  "federated_feed_url": null,
  "vendor_manifest_url": null
}
