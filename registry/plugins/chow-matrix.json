{
  "$schema": "../schema/plugin.schema.json",
  "id": "chow-matrix",
  "name": "ChowMatrix",
  "vendor": "ChowDSP",
  "category": "effect",
  "license": "BSD-3-Clause",
  "open_source": true,
  "homepage": "https://github.com/Chowdhury-DSP/ChowMatrix",
  "description": "Matrix delay with per-tap filtering and modulation.",
  "about": "A delay built from a grid of taps, each with its own time, pitch, filter and pan. It makes anything from simple echoes to swirling ambient textures.",
  "tags": ["delay", "ambient", "creative"],
  "enabled": true,
  "source": {
    "github": "Chowdhury-DSP/ChowMatrix",
    "asset_patterns": {
      "win_x64": "ChowMatrix-Win-[0-9.]+\\.exe",
      "mac_universal": "ChowMatrix-Mac-[0-9.]+\\.dmg"
    }
  },
  "install_strategy": "silent_installer",
  "silent_flags": "/VERYSILENT /NORESTART /SUPPRESSMSGBOXES",
  "auth_type": "none",
  "auth": null,
  "formats": ["vst3", "clap", "au"],
  "federated_feed_url": null,
  "vendor_manifest_url": null,
  "notes": "Windows installer type verified by signature before choosing silent flags."
}
