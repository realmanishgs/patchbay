{
  "$schema": "../schema/plugin.schema.json",
  "id": "paulxstretch",
  "name": "PaulXStretch",
  "vendor": "Jesse Chappell",
  "category": "effect",
  "license": "GPL-3.0-or-later",
  "open_source": true,
  "homepage": "https://github.com/essej/PaulXStretch",
  "description": "Extreme time-stretching for ambient textures.",
  "about": "Based on Paul's Extreme Sound Stretch, it can stretch audio by factors of thousands, turning short sounds into long evolving drones and pads. Works as a plugin or standalone.",
  "tags": ["timestretch", "ambient", "drone"],
  "enabled": true,
  "source": {
    "github": "essej/PaulXStretch",
    "asset_patterns": {
      "win_x64": "paulxstretch-[0-9.]+-win\\.exe",
      "mac_universal": "paulxstretch-[0-9.]+-mac\\.dmg"
    }
  },
  "install_strategy": "silent_installer",
  "silent_flags": "/VERYSILENT /NORESTART /SUPPRESSMSGBOXES",
  "auth_type": "none",
  "auth": null,
  "formats": ["vst3"],
  "federated_feed_url": null,
  "vendor_manifest_url": null,
  "notes": "Windows installer type verified by signature before choosing silent flags."
}
