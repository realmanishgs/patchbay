{
  "$schema": "../schema/plugin.schema.json",
  "id": "aida-x",
  "name": "AIDA-X",
  "vendor": "AIDA DSP",
  "category": "effect",
  "license": "GPL-3.0",
  "open_source": true,
  "homepage": "https://github.com/AidaDSP/AIDA-X",
  "description": "Neural amp and pedal model player.",
  "about": "Loads neural-network captures of guitar amps and pedals and plays them in real time. It includes EQ, a noise gate and cabinet impulse responses, so a full guitar chain fits in one plugin.",
  "tags": ["amp", "guitar", "neural", "capture"],
  "enabled": true,
  "source": {
    "github": "AidaDSP/AIDA-X",
    "asset_patterns": {
      "win_x64": "AIDA-X-[0-9.]+-win64\\.zip",
      "mac_universal": "AIDA-X-[0-9.]+-macos-universal-[0-9.]+\\.dmg"
    }
  },
  "install_strategy": "bundle_extract",
  "silent_flags": null,
  "auth_type": "none",
  "auth": null,
  "formats": ["vst3", "clap"],
  "federated_feed_url": null,
  "vendor_manifest_url": null
}
